public-hoist-pattern[]=*is-hotkey*
shamefully-hoist=true

# Approuver les scripts de build pour les packages nécessaires
enable-pre-post-scripts=true

# Force pnpm à utiliser un système de liens hoisted pour éviter les problèmes de scripts
# Nécessaire pour better-sqlite3 et esbuild utilisés par TinaCMS
node-linker=hoisted
